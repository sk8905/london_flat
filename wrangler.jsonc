{
  // Cloudflare Worker + static-assets config for the Flat Forecaster.
  // Deploy with:  npx wrangler deploy
  // (or connect the repo in the Cloudflare dashboard → Workers & Pages.)
  "name": "londonflat",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    // Serve the repo root as static assets; the Worker handles /api/* and the
    // assets binding serves everything else.
    "directory": "./",
    "binding": "ASSETS",
    // Unknown paths fall back to index.html (single-page app behaviour)...
    "not_found_handling": "single-page-application",
    // ...except /api/*, which must always reach the Worker (not the SPA fallback).
    "run_worker_first": ["/api/*"]
  }
}
