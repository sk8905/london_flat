# Cloudflare Pages headers (unused in production — this repo deploys via the
# Worker's [assets] binding, which ignores this file; worker.js sets the same
# no-cache policy directly). Kept in case of a future Pages-only deploy.
/*
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/assets/*
  Cache-Control: no-cache, must-revalidate
